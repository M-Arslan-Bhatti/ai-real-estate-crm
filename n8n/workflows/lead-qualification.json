{
  "name": "EstateFlow — Lead qualification",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "estateflow/new-lead",
        "responseMode": "responseNode"
      },
      "id": "webhook",
      "name": "New Lead Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.CRM_API_URL }}/api/automations/qualify",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-Workflow-Secret", "value": "={{ $env.CRM_WORKFLOW_SECRET }}" },
            { "name": "Idempotency-Key", "value": "={{ $json.idempotencyKey }}" }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "qualify",
      "name": "Qualify and Assign",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 0]
    },
    {
      "parameters": { "respondWith": "json", "responseBody": "={{ $json }}" },
      "id": "respond",
      "name": "Return Result",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [480, 0]
    }
  ],
  "connections": {
    "New Lead Webhook": { "main": [[{ "node": "Qualify and Assign", "type": "main", "index": 0 }]] },
    "Qualify and Assign": { "main": [[{ "node": "Return Result", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1", "saveDataErrorExecution": "all" },
  "active": false,
  "versionId": "estateflow-lead-qualification-v1"
}
