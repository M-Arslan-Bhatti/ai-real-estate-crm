{
  "name": "EstateFlow — Lead capture and qualification",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "estateflow/new-lead",
        "responseMode": "responseNode"
      },
      "id": "webhook",
      "name": "New Lead Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.CRM_API_URL }}/api/leads",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-CRM-Webhook-Secret", "value": "={{ $env.CRM_WORKFLOW_SECRET }}" }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify($json.body ?? $json) }}"
      },
      "id": "capture",
      "name": "Capture Qualify Assign",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 0]
    },
    {
      "parameters": { "respondWith": "json", "responseBody": "={{ $json }}" },
      "id": "respond",
      "name": "Return Result",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [480, 0]
    }
  ],
  "connections": {
    "New Lead Webhook": { "main": [[{ "node": "Capture Qualify Assign", "type": "main", "index": 0 }]] },
    "Capture Qualify Assign": { "main": [[{ "node": "Return Result", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1", "saveDataErrorExecution": "all", "saveDataSuccessExecution": "none" },
  "active": false,
  "versionId": "estateflow-lead-capture-v2"
}
