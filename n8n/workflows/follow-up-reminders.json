{
  "name": "EstateFlow — Follow-up reminders",
  "nodes": [
    {
      "parameters": { "rule": { "interval": [{ "field": "minutes", "minutesInterval": 15 }] } },
      "id": "schedule",
      "name": "Every 15 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.CRM_API_URL }}/api/automations/due-followups",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-Workflow-Secret", "value": "={{ $env.CRM_WORKFLOW_SECRET }}" },
            { "name": "Idempotency-Key", "value": "=followups-{{ $now.toFormat('yyyyMMddHHmm') }}" }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "{}"
      },
      "id": "fetch",
      "name": "Fetch Due Follow-ups",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 0],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    }
  ],
  "connections": {
    "Every 15 Minutes": { "main": [[{ "node": "Fetch Due Follow-ups", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1", "saveDataErrorExecution": "all", "saveDataSuccessExecution": "none" },
  "active": false,
  "versionId": "estateflow-followups-v1"
}
