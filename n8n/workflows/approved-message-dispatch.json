{
  "name": "EstateFlow — Approved message dispatch",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "estateflow/approved-message",
        "responseMode": "responseNode"
      },
      "id": "webhook",
      "name": "Approved Message",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true },
          "conditions": [
            {
              "leftValue": "={{ $json.headers['x-workflow-secret'] }}",
              "rightValue": "={{ $env.CRM_WORKFLOW_SECRET }}",
              "operator": { "type": "string", "operation": "equals" }
            }
          ]
        }
      },
      "id": "verify",
      "name": "Verify Secret",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.CRM_API_URL }}/api/automations/dispatch-approved",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-Workflow-Secret", "value": "={{ $env.CRM_WORKFLOW_SECRET }}" },
            { "name": "Idempotency-Key", "value": "={{ $json.headers['idempotency-key'] }}" }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ draft_id: $json.body.draft.id }) }}"
      },
      "id": "complete",
      "name": "Mark Sent After Channel",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, -80],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": { "respondWith": "json", "responseBody": "={{ $json }}" },
      "id": "respond",
      "name": "Return Dispatch Result",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [700, -80]
    }
  ],
  "connections": {
    "Approved Message": { "main": [[{ "node": "Verify Secret", "type": "main", "index": 0 }]] },
    "Verify Secret": { "main": [[{ "node": "Mark Sent After Channel", "type": "main", "index": 0 }], []] },
    "Mark Sent After Channel": { "main": [[{ "node": "Return Dispatch Result", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1", "saveDataErrorExecution": "all", "saveDataSuccessExecution": "none" },
  "active": false,
  "versionId": "estateflow-approved-dispatch-v1"
}
